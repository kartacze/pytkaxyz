<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  class="w-6 h-6 sm:w-7 sm:h-7 dark:w-6 dark:h-6 sm:dark:w-7 sm:dark:h-7 i-carbon-sun dark:i-carbon-moon bg-primary"
></button>

<style>
  :global(.dark) {
    color-scheme: dark;
  }
</style>

<script>
  // The initial theme is applied by the inline script in Layout's <head>.
  const applyTheme = (doc: Document, theme: string) => {
    doc.documentElement.classList.toggle('dark', theme === 'dark')
    doc.documentElement.dataset.theme = theme
  }

  // Carry the current theme over to the incoming page on client-side navigation
  document.addEventListener('astro:before-swap', (ev) => {
    applyTheme(
      ev.newDocument,
      document.documentElement.dataset.theme ?? 'light'
    )
  })

  // Fires on the first load and after every navigation (the button is replaced)
  document.addEventListener('astro:page-load', () => {
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const theme =
        document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
      applyTheme(document, theme)
      localStorage.setItem('theme', theme)
    })
  })
</script>

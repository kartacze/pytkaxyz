---
const { title, text, secondaryText, link } = Astro.props
---

<a
  rel="noopener noreferrer"
  href={link}
  target="_blank"
  class="group relative flex w-full h-[360px] sm:h-[220px] rounded cursor-pointer"
>
  <div class="flex flex-col w-full z-10 p-10 gap-4 text-white">
    <h3 class="z-10 text-4xl font-mono group-hover:bg-clip-padding">
      {title}
    </h3>
    <!-- Always visible on touch screens, revealed on hover/focus from sm up -->
    <p
      class="transition ease-in-out delay-150 font-mono text-base sm:opacity-0 sm:group-hover:opacity-100 sm:group-focus-visible:opacity-100"
    >
      {text}
    </p>
    <p
      class="transition ease-in-out delay-150 font-mono text-base sm:opacity-0 sm:group-hover:opacity-100 sm:group-focus-visible:opacity-100"
    >
      {secondaryText}
    </p>
  </div>

  <div
    class="z-0 transition ease-in-out delay-250 absolute inset-0 flex overflow-hidden content-center items-center rounded-lg"
  >
    <div
      class="transition ease-in-out delay-150 duration-1000 group-hover:-translate-y-2 group-hover:scale-110 rounded-lg brightness-50 sm:brightness-70 group-hover:brightness-30 h-full w-full flex"
    >
      <slot />
    </div>
  </div>
</a>

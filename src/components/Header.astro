---
import NavLink from '../components/NavLink.astro'
import ThemeControls from '../components/ThemeControls.astro'

// Drop the trailing slash so "/about/" matches "/about"
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'

// Section links stay active on nested pages, e.g. /blog on /blog/some-post
const isActive = (link: string) =>
  link === '/'
    ? currentPath === '/'
    : currentPath === link || currentPath.startsWith(link + '/')

const links = [
  {
    link: '/',
    title: 'home',
  },
  ...['about', 'blog', 'projects'].map((i) => ({ link: '/' + i, title: i })),
]
---

<header class="flex flex-col items-start my-4 relative font-mono">
  <div class="flex self-stretch w-full flex-[0_0_auto] items-center my-4">
    <div
      class="flex flex-wrap justify-between flex-1 grow items-center gap-x-3 gap-y-3 relative"
    >
      <nav
        aria-label="Main"
        class="inline-flex items-center sm:gap-3 gap-2 relative flex-[0_0_auto]"
      >
        {
          links.map((link) => (
            <NavLink
              link={link.link}
              title={link.title}
              isActive={isActive(link.link)}
            />
          ))
        }
      </nav>
      <div class="inline-flex gap-2 flex-[0_0_auto] items-center">
        <a
          rel="noopener noreferrer"
          href="https://github.com/kartacze"
          target="_blank"
          aria-label="GitHub (opens in a new tab)"
          class="site-icon w-6 h-6 sm:w-7 sm:h-7 i-carbon-logo-github dark:bg-white text-primary"
        ></a>
        <a
          rel="noopener noreferrer"
          href="https://www.linkedin.com/in/teodor-pytka/"
          target="_blank"
          aria-label="LinkedIn (opens in a new tab)"
          class="site-icon w-6 h-6 sm:w-7 sm:h-7 i-carbon-logo-linkedin dark:bg-white text-primary"
        ></a>
        <ThemeControls />
      </div>
    </div>
  </div>
  <div class="site-rule h-[2px] bg-primary w-full"></div>
</header>

---
const { title, link, isActive } = Astro.props
---

<a
  href={link}
  aria-current={isActive ? 'page' : undefined}
  class={`text-base sm:text-lg leading-[normal] [text-transform:capitalize] transition-colors ${isActive ? 'text-primary underline decoration-2 underline-offset-8' : 'text-muted hover:text-primary'}`}
>
  {title}
</a>

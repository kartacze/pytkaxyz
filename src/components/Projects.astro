---
import Card from './Card.astro'
import { Image } from 'astro:assets'
import ceiling from '../assets/ceiling.jpg' // Image is 1600x900
import assimilation from '../assets/assimilation.jpg' // Image is 1600x900

const projects = [
  {
    title: 'Turpia',
    text: 'Money has no value; it is information. And information is priceless. Manage it correctly.',
    secondaryText: 'My attempt to handle it better.',
    link: 'https://github.com/kartacze/turpia',
    image: ceiling,
  },
  {
    title: 'Assimilation',
    text: 'My playground for machine learning in robotics. The plan: a simple simulator where I can try out motion, control and learning, before anything touches real hardware.',
    secondaryText: 'It starts small: a pendulum, a two-jointed arm and a balancing cart. Try it in your browser.',
    link: '/assimilation/',
    image: assimilation,
  },
]
---

<div class="flex flex-col gap-8 w-full">
  {
    projects.map((project) => (
      <Card
        title={project.title}
        text={project.text}
        link={project.link}
        secondaryText={project.secondaryText}
      >
        <Image class="w-full object-cover" src={project.image} alt="" />
      </Card>
    ))
  }
</div>

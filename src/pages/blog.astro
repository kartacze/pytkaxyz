---
import Layout from '../layouts/Layout.astro'
import { getCollection } from 'astro:content'

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)
---

<Layout title="Blog · Pytka.xyz">
  <main transition:animate="fade" class="flex flex-col items-start gap-8 pb-8">
    <section class="flex flex-col gap-2 prose">
      <h1 class="text-3xl prose-truegray font-mono">Blog</h1>
      <p class="font-mono text-base">
        Notes, tutorials and thoughts. By now the only plan for this blog is to
        note everything I'm doing right now that I would like to recall some
        time in the future. My memory is great but short.
      </p>
    </section>

    <ul class="flex flex-col gap-4 w-full">
      {
        posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}`}
              class="group flex flex-col gap-1 rounded p-4 border border-primary-800/20 hover:border-primary"
            >
              <h2 class="font-mono text-xl group-hover:underline">
                {post.data.title}
              </h2>
              <p class="font-mono text-sm text-primary">
                {post.data.pubDate.toDateString()}
              </p>
              <p class="font-mono text-base">{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>

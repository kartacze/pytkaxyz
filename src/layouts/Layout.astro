---
import { ClientRouter } from 'astro:transitions'
import Header from '../components/Header.astro'

interface Props {
  title?: string
  description?: string
  type?: 'website' | 'article'
}

const {
  title = 'Teodor Pytka · Full-stack Developer',
  description = 'Teodor Pytka, a full-stack developer based in Warsaw, Poland.',
  type = 'website',
} = Astro.props

// Static pages are served as directories, so their canonical form ends in "/"
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`
const canonical = new URL(pathname, Astro.site)
---

<!doctype html>
<html lang="en" class="h-full w-full antialiased bg-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Pytka.xyz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <ClientRouter />
    <!-- Runs before first paint so dark mode doesn't flash light. Only an
         explicit toggle is stored; otherwise the OS preference is followed. -->
    <script is:inline>
      ;(() => {
        const theme =
          localStorage.getItem('theme') ??
          (matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light')
        document.documentElement.classList.toggle('dark', theme === 'dark')
        document.documentElement.dataset.theme = theme
      })()
    </script>
  </head>
  <body
    class="relative min-h-screen text-neutral-800 dark:bg-black dark:text-neutral-200"
  >
    <div
      class="flex m-auto min-h-screen w-full max-w-[920px] h-full sm:bg-[#fffdfdaa] dark:bg-[#232211] sm:shadow-[0px_4px_23px_10px_#95553566]"
    >
      <div
        id="color-blend"
        class="h-screen w-screen fixed inset-0 mix-blend-color-burn [background:radial-gradient(50%_50%_at_50%_50%,rgba(42.67,111.93,167.88,0.45)_0%,rgba(149.81,85.71,53.06,0.4)_54.81%)] opacity-80 dark:opacity-100"
      >
      </div>

      <div
        class="flex flex-row flex-1 w-full items-center sm:mx-20 mx-4 py-0 relative"
      >
        <article class="flex flex-1 flex-col min-h-full sm:gap-12 gap-8">
          <Header />
          <slot />
        </article>
      </div>
    </div>
    <style is:global>
      :root {
        --blue: #2b70a8;
        --brown: #965635;
      }

      html[data-theme='dark'] {
        --blue: #aa00ff;
        --brown: #905662;
      }

      html {
        height: 100%;
      }
      body {
        min-height: 100%;
      }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        #color-blend {
          mix-blend-mode: color-burn;
        }
        background:
          radial-gradient(
            121.38% 73.52% at 50% 50%,
            rgba(150, 86, 53, 0.4) 0%,
            rgba(229, 191, 91, 0.34) 60.25%,
            rgba(43, 112, 168, 0.45) 100%
          ),
          #fff;
      }
      code {
        font-family: var(--font-mono);
      }
    </style>
  </body>
</html>

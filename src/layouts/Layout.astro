---
import { ClientRouter } from 'astro:transitions'
import Header from '../components/Header.astro'
import { designs } from '../designs'
import '../styles/designs.css'

interface Props {
  title?: string
  description?: string
  type?: 'website' | 'article'
}

const {
  title = 'Teodor Pytka · Full-stack Developer',
  description = 'Teodor Pytka, a full-stack developer based in Warsaw, Poland.',
  type = 'website',
} = Astro.props

// Static pages are served as directories, so their canonical form ends in "/"
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`
const canonical = new URL(pathname, Astro.site)
---

<!doctype html>
<html lang="en" class="h-full w-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Pytka.xyz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <ClientRouter />
    <!-- Runs before first paint so the design and theme don't flash. Both are
         stored by the header buttons; without a stored theme the OS
         preference is followed. -->
    <script is:inline define:vars={{ designs }}>
      const design = designs.find(
        (d) => d.id === localStorage.getItem('design')
      )
      const theme =
        localStorage.getItem('theme') ??
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
      if (design) document.documentElement.dataset.design = design.id
      document.documentElement.classList.toggle('dark', theme === 'dark')
      document.documentElement.dataset.theme = theme
    </script>
  </head>
  <body class="relative min-h-screen">
    <div
      class="site-panel flex m-auto min-h-screen w-full max-w-[920px] h-full"
    >
      <div
        class="flex flex-row flex-1 w-full items-center sm:mx-20 mx-4 py-0 relative"
      >
        <article class="flex flex-1 flex-col min-h-full sm:gap-12 gap-8">
          <Header />
          <slot />
        </article>
      </div>
    </div>
    <style is:global>
      /* Original design tokens; the alternative designs in
         src/styles/designs.css override these surfaces with their own. */
      :root {
        --brown: #9a5634;
        --ink: #241d18;
        --ink-soft: #4a3f37;
        --muted: #85766a;
        --rule: rgb(154 86 52 / 0.22);
        --paper: #f7f1e8;
        --panel: rgb(255 252 247 / 0.62);
        --glow-warm: rgb(154 86 52 / 0.26);
        --glow-cool: rgb(43 112 168 / 0.2);
      }

      html[data-theme='dark'] {
        --brown: #e0a27a;
        --ink: #f3ebe1;
        --ink-soft: #d3c8bc;
        --muted: #9c8f83;
        --rule: rgb(224 162 122 / 0.2);
        --paper: #14110e;
        --panel: rgb(30 25 21 / 0.72);
        --glow-warm: rgb(224 162 122 / 0.14);
        --glow-cool: rgb(106 166 216 / 0.12);
      }

      html {
        height: 100%;
      }
      body {
        min-height: 100%;
      }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        color: var(--ink-soft);
        background:
          radial-gradient(60% 50% at 0% 0%, var(--glow-warm), transparent 70%),
          radial-gradient(
            55% 45% at 100% 100%,
            var(--glow-cool),
            transparent 70%
          ),
          var(--paper);
        background-attachment: fixed;
      }

      .site-panel {
        background: var(--panel);
      }

      @media (min-width: 640px) {
        .site-panel {
          border-inline: 1px solid var(--rule);
          box-shadow: 0 0 80px -30px rgb(60 30 10 / 0.35);
        }
      }

      /* Warm the typography plugin's grays to match the palette */
      html .prose {
        --un-prose-body: var(--ink-soft);
        --un-prose-headings: var(--ink);
        --un-prose-lead: var(--ink-soft);
        --un-prose-links: var(--brown);
        --un-prose-bold: var(--ink);
        --un-prose-counters: var(--muted);
        --un-prose-bullets: var(--muted);
        --un-prose-hr: var(--rule);
        --un-prose-quotes: var(--ink);
        --un-prose-quote-borders: var(--rule);
        --un-prose-captions: var(--muted);
        --un-prose-code: var(--ink);
        --un-prose-pre-bg: #1f1a16;
        --un-prose-th-borders: var(--rule);
        --un-prose-td-borders: var(--rule);
      }

      ::selection {
        background: rgb(154 86 52 / 0.25);
      }

      code {
        font-family: var(--font-mono);
      }
    </style>
  </body>
</html>
